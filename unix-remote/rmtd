#!/usr/bin/env python3
"""rmtd -- fake Symbolics VLM "remote unix" tape server.

The Genera VLM has no tape driver.  To reach a tape it opens a BSD `rexec`
connection (TCP 512) to a host carrying the `(:TAPE :TCP :UNIX-REXEC)` service,
runs `/usr/sbin/rmt`, and drives it with the classic BSD remote-magtape (rmt)
protocol.  See sys.sct/embedding/ux/{unix-protocols,unix-tape}.lisp.

This one process impersonates all of it: rexecd + /etc/rmt + the tape drive.
The "tape" is a regular file in SIMH .tap format, so filemarks / multi-file
tapes work and images interchange with other tools.

  Genera picks one of three rmt dialects from the tape host's namespace MACHINE
  TYPE (unix-tape.lisp: sun-host-p / dec-axp-host-p).  Portable Genera registers
  its own embedding host as machine type Macintosh, system type macOS
  (namespaces.lisp: emb-host-machine-type / emb-host-system-type), which is
  neither Sun nor DEC-AXP, so the tape stream gets the DEFAULT ("vax") dialect:

    * it does issue the binary `S` status command, so rmtd answers with a real
      struct mtget prefix -- drive type 0x03, Unibus TM-11, one of the only two
      types Genera has a status decoder for (vax-unibus-tm-11-status);
    * allow-short-input-records-p is NIL, so a read returning fewer bytes than
      were asked for means END OF FILE.  rmtd therefore satisfies each `R` from
      as many tape records as it takes, stopping only at a filemark or at end
      of medium, and splitting a record if one overruns the request;
    * the device string is parsed as <prefix><unit 0-3> -- use "mt0", NOT the
      DEC-AXP "mt0h" form, and never "Cart";
    * the rexec command is /etc/rmt rather than DEC-AXP's /usr/sbin/rmt, which
      is how rmtd tells the two dialects apart in the log.

  A host registered as DEC-AXP still works: rmtd serves both dialects, and the
  read semantics below (never cross a filemark; a zero-length read consumes it)
  are the ones a real Unix tape driver has, which is what each dialect expects.

SECURITY: rexec credentials are accepted and ignored (Genera sends none that
mean anything here), so anyone who can open the port can read the tape image
and erase it (MTERASE truncates it to zero bytes).  rmtd therefore binds the
vmnet bridge address by default -- like lpdd -- and refuses a wildcard bind
unless --insecure-any-interface says otherwise.  The bridge exists only while
the VLM is running.  Root is needed only to bind port 512, so rmtd drops to
$SUDO_USER (or --user) as soon as the bind is done; the request loop never runs
as root.

Run (port 512 is privileged):
    sudo ./rmtd --tape /path/to/genera.tap
Test against a high port without root:
    ./rmtd --tape test.tap --host 127.0.0.1 --port 1512 -v
"""

import argparse
import logging
import os
import pwd
import socket
import struct
import sys

DEFAULT_PORT = 512
DEFAULT_HOST = "192.168.2.1"            # vmnet bridge, up only while the VLM runs

# mtio MTIOCTOP opcodes -- order from sys.sct/embedding/ux/unix-tape.lisp.
MTWEOF, MTFSF, MTBSF, MTFSR, MTBSR, MTREW, MTOFFL, MTNOP, MTRETEN, MTERASE, MTEOM = range(11)
_OP_NAME = {MTWEOF: "WEOF", MTFSF: "FSF", MTBSF: "BSF", MTFSR: "FSR", MTBSR: "BSR",
           MTREW: "REW", MTOFFL: "OFFL", MTNOP: "NOP", MTRETEN: "RETEN",
           MTERASE: "ERASE", MTEOM: "EOM"}

# struct mtget prefix for the `S` (status) reply, as Genera decodes it
# (unix-tape.lisp rmt-read-status): mt_type, mt_dsreg, mt_erreg, 2 bytes each.
# A zero first byte tells Genera the reply is big-endian.  Only drive types
# 0x03 and 0x14 have a status decoder; 0x03 is the one that decodes anything.
MT_TYPE_TM11 = 0x03

# mt_erreg bits, per vax-unibus-tm-11-status.  ONLINE is inverted there: with
# it clear the drive reads as offline and Genera waits for an operator.
ER_EOF, ER_HARD_ERROR, ER_EOT = 0x4000, 0x1000, 0x0400
ER_ONLINE, ER_BOT, ER_WRITE_LOCK, ER_REWINDING = 0x0040, 0x0020, 0x0004, 0x0002

# SIMH .tap metadata markers (4-byte little-endian record headers/trailers).
TAPEMARK = 0x00000000        # tape mark (filemark)
EOM_MARK = 0xFFFFFFFF        # end of medium
ERASE_GAP = 0xFFFFFFFE       # erase gap -- skip over

log = logging.getLogger("rmtd")


class Tape:
    """A SIMH .tap file presented as a sequential tape with filemarks.

    Each record:  <u32 len> <len bytes data> [pad to even] <u32 len>
    A filemark:   <u32 0x00000000>            (no trailer)
    """

    def __init__(self, path):
        self.path = path
        if not os.path.exists(path):
            open(path, "wb").close()
            log.info("created empty tape image %s", path)
        self.f = open(path, "r+b")
        # Bytes of a record that overran the last `R` request, still owed to
        # the client, and the sticky "last read hit a filemark" status bit.
        self.pending = b""
        self.saw_filemark = False

    def reposition(self):
        """Any tape motion drops a half-delivered record and the EOF bit."""
        self.pending = b""
        self.saw_filemark = False

    def reopen(self):
        """The rmt `O` command on a no-rewind device: keeps position."""
        self.saw_filemark = False

    def close(self):
        try:
            self.f.flush()
            os.fsync(self.f.fileno())
        except OSError:
            pass
        self.f.close()

    # --- forward motion ---------------------------------------------------
    def read_block(self):
        """Return ('data', bytes) | ('mark', b'') | ('eom', b'').

        On 'data'/'mark' the file is left positioned after the item; on 'eom'
        the position is left at the marker so a following write can extend.
        """
        pos = self.f.tell()
        hdr = self.f.read(4)
        if len(hdr) < 4:
            self.f.seek(pos)
            return ("eom", b"")
        (n,) = struct.unpack("<I", hdr)
        if n == TAPEMARK:
            return ("mark", b"")            # already stepped past the 4-byte mark
        if n == ERASE_GAP:
            return self.read_block()        # transparent
        if n == EOM_MARK:
            self.f.seek(pos)
            return ("eom", b"")
        length = n & 0x7FFFFFFF             # bit31 = error flag in SIMH; ignore it
        data = self.f.read(length)
        if length & 1:
            self.f.read(1)                  # padding byte
        self.f.read(4)                      # trailer
        return ("data", data)

    def read_data(self, count):
        """Return up to `count` bytes, never crossing a filemark.

        This is what read(2) does on a Unix tape, and both rmt dialects are
        written against it: a short return means "the file ends here", and the
        filemark itself is stepped over by the following zero-length read.  A
        host with allow-short-input-records-p NIL (anything not DEC-AXP, which
        includes Portable Genera's own macOS host) treats ANY short return as
        EOF, so records have to be coalesced up to `count` -- returning one
        record per call would end every file after its first record.
        """
        out = bytearray()
        while len(out) < count:
            need = count - len(out)
            if self.pending:
                out += self.pending[:need]
                self.pending = self.pending[need:]
                continue
            pos = self.f.tell()
            kind, data = self.read_block()
            if kind == "mark":
                if out:
                    self.f.seek(pos)        # leave it for the next, empty read
                else:
                    self.saw_filemark = True    # zero-length read consumes it
                break
            if kind == "eom":               # read_block left us on the marker
                break
            self.saw_filemark = False
            if len(data) > need:
                out += data[:need]
                self.pending = data[need:]
            else:
                out += data
        return bytes(out)

    # --- status -----------------------------------------------------------
    def at_eom(self):
        if self.pending:
            return False
        pos = self.f.tell()
        hdr = self.f.read(4)
        self.f.seek(pos)
        if len(hdr) < 4:
            return True
        (n,) = struct.unpack("<I", hdr)
        return n == EOM_MARK

    def status_erreg(self):
        """mt_erreg for the `S` reply (vax-unibus-tm-11-status decodes it)."""
        bits = ER_ONLINE
        if self.f.tell() == 0 and not self.pending:
            bits |= ER_BOT
        if self.saw_filemark:
            bits |= ER_EOF
        if self.at_eom():
            bits |= ER_EOT
        return bits

    def fsf(self, count):
        self.reposition()
        for _ in range(count):
            while True:
                kind, _ = self.read_block()
                if kind == "mark":
                    break
                if kind == "eom":
                    return

    def fsr(self, count):
        self.reposition()
        for _ in range(count):
            kind, _ = self.read_block()
            if kind in ("mark", "eom"):
                break

    # --- backward motion (best effort; Genera flags reverse-skip unsupported)
    def _back_one(self):
        pos = self.f.tell()
        if pos <= 0:
            self.f.seek(0)
            return "bot"
        self.f.seek(pos - 4)
        (v,) = struct.unpack("<I", self.f.read(4))
        if v == TAPEMARK:
            self.f.seek(pos - 4)
            return "mark"
        length = v & 0x7FFFFFFF
        newpos = pos - 4 - (length & 1) - length - 4
        self.f.seek(max(0, newpos))
        return "data"

    def bsf(self, count):
        self.reposition()
        for _ in range(count):
            while True:
                kind = self._back_one()
                if kind == "bot":
                    return
                if kind == "mark":
                    break

    def bsr(self, count):
        self.reposition()
        for _ in range(count):
            if self._back_one() == "bot":
                return

    def rewind(self):
        self.reposition()
        self.f.seek(0)

    def seek_eom(self):
        self.reposition()
        while self.read_block()[0] != "eom":
            pass

    # --- writing ----------------------------------------------------------
    def write_block(self, data):
        self.reposition()
        n = len(data)
        self.f.write(struct.pack("<I", n))
        self.f.write(data)
        if n & 1:
            self.f.write(b"\x00")
        self.f.write(struct.pack("<I", n))
        self.f.truncate()                   # writing erases everything past here
        self.f.flush()

    def write_mark(self):
        self.reposition()
        self.f.write(struct.pack("<I", TAPEMARK))
        self.f.truncate()
        self.f.flush()

    def erase(self):
        self.reposition()
        self.f.seek(0)
        self.f.truncate()


def _read_cstr(rf):
    """Read a NUL-terminated field from the rexec preamble."""
    out = bytearray()
    while True:
        b = rf.read(1)
        if not b:
            raise EOFError("eof during rexec handshake")
        if b == b"\x00":
            return bytes(out)
        out += b


def _read_exact(rf, n):
    buf = bytearray()
    while len(buf) < n:
        chunk = rf.read(n - len(buf))
        if not chunk:
            raise EOFError("eof reading %d bytes of write data" % n)
        buf += chunk
    return bytes(buf)


def handle(conn, tape_path):
    rf = conn.makefile("rb")
    wf = conn.makefile("wb")

    # --- rexec handshake: "\0 user \0 pass \0 command \0", reply one \0 ----
    _stderr_port = _read_cstr(rf)
    user = _read_cstr(rf).decode("latin-1")
    _passwd = _read_cstr(rf)
    command = _read_cstr(rf).decode("latin-1")
    # net:define-protocol :unix-rexec runs /usr/sbin/rmt for a DEC-AXP host and
    # /etc/rmt for everything else, so the command names the dialect Genera
    # chose from the namespace machine type.  Worth logging: a host that should
    # be the default (Portable Genera macOS) dialect but asks for /usr/sbin/rmt
    # has been registered as a DEC Alpha by mistake, and vice versa.
    dialect = "DEC-AXP" if command.endswith("/usr/sbin/rmt") else "default (vax)"
    log.info("rexec: user=%r command=%r -> %s dialect (creds ignored)",
             user, command, dialect)
    wf.write(b"\x00")                       # success
    wf.flush()

    tape = Tape(tape_path)

    def reply(fmt, *args):
        line = (fmt % args).encode("latin-1")
        wf.write(line)
        wf.flush()
        log.debug("  -> %r", line)

    try:
        while True:
            cmd = rf.read(1)
            if not cmd:
                log.info("client closed connection")
                break

            if cmd == b"O":                 # O<device>\n<mode>\n  -- open, keep position
                dev = rf.readline().rstrip(b"\n")
                mode = rf.readline().rstrip(b"\n")
                log.debug("O dev=%r mode=%r", dev, mode)
                tape.reopen()
                reply("A0\n")

            elif cmd == b"C":               # C<device>\n  -- close
                dev = rf.readline().rstrip(b"\n")
                log.debug("C dev=%r", dev)
                reply("A0\n")

            elif cmd == b"R":               # R<count>\n  -- read up to count bytes
                count = int(rf.readline())
                data = tape.read_data(count)
                if not data:                # filemark or eom -> EOF to Genera
                    log.debug("R %d -> A0 (end of file)", count)
                reply("A%d\n", len(data))
                if data:
                    wf.write(data)
                    wf.flush()

            elif cmd == b"W":               # W<count>\n + <count> bytes  -- write
                count = int(rf.readline())
                data = _read_exact(rf, count)
                tape.write_block(data)
                reply("A%d\n", count)

            elif cmd == b"L":               # L<offset>\n<whence>\n  -- lseek
                off = int(rf.readline())
                whence = int(rf.readline())
                tape.reposition()
                tape.f.seek(off, whence)    # Genera only ever rewinds (0,0); this is general
                reply("A%d\n", tape.f.tell())

            elif cmd == b"I":               # I<op>\n<count>\n  -- MTIOCTOP
                op = int(rf.readline())
                cnt = int(rf.readline())
                log.debug("I op=%s count=%d", _OP_NAME.get(op, op), cnt)
                if op == MTWEOF:
                    for _ in range(cnt):
                        tape.write_mark()
                elif op == MTFSF:
                    tape.fsf(cnt)
                elif op == MTBSF:
                    tape.bsf(cnt)
                elif op == MTFSR:
                    tape.fsr(cnt)
                elif op == MTBSR:
                    tape.bsr(cnt)
                elif op in (MTREW, MTOFFL):
                    tape.rewind()
                elif op == MTEOM:
                    tape.seek_eom()
                elif op == MTERASE:
                    tape.erase()
                elif op in (MTNOP, MTRETEN):
                    pass
                else:
                    log.warning("unhandled ioctl op %d", op)
                reply("A0\n")

            elif cmd == b"S":               # status -- struct mtget, no newline
                # Genera only ever looks at the first 6 bytes: mt_type,
                # mt_dsreg (which its TM-11 decoder ignores) and mt_erreg.
                erreg = tape.status_erreg()
                blob = struct.pack(">HHH", MT_TYPE_TM11, 0, erreg)
                log.debug("S -> type=%#04x erreg=%#06x%s%s%s", MT_TYPE_TM11, erreg,
                          " bot" if erreg & ER_BOT else "",
                          " eof" if erreg & ER_EOF else "",
                          " eot" if erreg & ER_EOT else "")
                reply("A%d\n", len(blob))
                wf.write(blob)
                wf.flush()

            else:
                log.error("unknown rmt command %r; closing", cmd)
                reply("E22\nunknown command\n")
                break
    finally:
        tape.close()
        try:
            wf.close()
            rf.close()
        except OSError:
            pass


def drop_privileges(want_user):
    """Give up root once the privileged port is bound.

    Nothing past the bind needs it: the only file rmtd ever touches is the tape
    image named on the command line (the rmt `O` command's device name is read
    and ignored), so the request loop has no business running as root.
    Returns the user we became, or None if we were never root.
    """
    if os.geteuid() != 0:
        return None

    name = want_user or os.environ.get("SUDO_USER")
    try:
        if name:
            pw = pwd.getpwnam(name)
        elif os.environ.get("SUDO_UID"):
            pw = pwd.getpwuid(int(os.environ["SUDO_UID"]))
        else:
            log.warning("running as root with no --user and no SUDO_USER: "
                        "staying root (pass --user to drop privileges)")
            return None
    except (KeyError, ValueError) as e:
        sys.exit("--user: %s" % e)

    if pw.pw_uid == 0:
        log.warning("--user names root: staying root")
        return None

    os.initgroups(pw.pw_name, pw.pw_gid)    # supplementary groups, still root
    os.setgid(pw.pw_gid)
    os.setuid(pw.pw_uid)                    # euid 0 -> real, effective and saved
    return pw.pw_name


def check_tape_access(path):
    """Fail at startup, not on the first connection, if the tape is unreachable.

    Worth doing right after the privilege drop: an image an earlier root run
    created is root-owned, and would otherwise fail only when Genera dials in.
    """
    if os.path.exists(path):
        if not os.access(path, os.R_OK | os.W_OK):
            sys.exit("tape %s is not readable/writable as the current user\n"
                     "(created by an earlier root run?  chown it, or pass --user root)"
                     % path)
    else:
        directory = os.path.dirname(os.path.abspath(path))
        if not os.access(directory, os.W_OK):
            sys.exit("cannot create tape %s: %s is not writable as the current user"
                     % (path, directory))


def main():
    ap = argparse.ArgumentParser(description="fake VLM rexec+rmt tape server")
    ap.add_argument("--tape", required=True, help="path to the .tap tape image (created if absent)")
    ap.add_argument("--host", default=DEFAULT_HOST,
                    help="bind address (default: vmnet bridge %s)" % DEFAULT_HOST)
    ap.add_argument("--port", type=int, default=DEFAULT_PORT,
                    help="TCP port (default 512; <1024 needs root)")
    ap.add_argument("--insecure-any-interface", action="store_true",
                    help="permit binding a wildcard/routable address (see SECURITY above)")
    ap.add_argument("--user", default=None,
                    help="user to drop to after binding (default: $SUDO_USER)")
    ap.add_argument("-v", "--verbose", action="count", default=0,
                    help="-v traces commands, -vv adds replies")
    args = ap.parse_args()

    level = logging.WARNING - 10 * min(args.verbose, 2)
    logging.basicConfig(level=level, format="%(asctime)s %(levelname)s %(message)s")

    # rmt is unauthenticated and exposes MTERASE and lseek+write over the whole
    # tape image, so a wildcard bind hands every host that can reach this Mac
    # the ability to read or destroy it.  Refuse unless explicitly overridden.
    if args.host in ("", "0.0.0.0", "::") and not args.insecure_any_interface:
        sys.exit("refusing to bind %s: rmtd is unauthenticated and can erase the tape.\n"
                 "Bind the vmnet bridge (--host %s, the default) or, if you really mean\n"
                 "to serve every interface, pass --insecure-any-interface."
                 % (args.host or "all interfaces", DEFAULT_HOST))

    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind((args.host, args.port))
    except PermissionError:
        sys.exit("bind %s:%d failed: port <1024 needs sudo" % (args.host, args.port))
    except OSError as e:
        # EADDRNOTAVAIL: the bridge address only exists while the VLM runs.
        sys.exit("bind %s:%d failed: %s\n"
                 "(the vmnet bridge address exists only while the VLM is running)"
                 % (args.host, args.port, e))
    srv.listen(1)                           # one tape drive: serve sequentially

    dropped = drop_privileges(args.user)    # root was only ever for the bind
    check_tape_access(args.tape)

    log.warning("rmtd listening on %s:%d, tape=%s%s", args.host, args.port, args.tape,
                (", running as %s" % dropped) if dropped else "")

    try:
        while True:
            conn, peer = srv.accept()
            log.info("connection from %s:%d", *peer)
            try:
                handle(conn, args.tape)
            except (EOFError, ConnectionError) as e:
                log.info("connection ended: %s", e)
            except Exception:
                log.exception("error handling connection")
            finally:
                conn.close()
    except KeyboardInterrupt:
        log.warning("shutting down")
    finally:
        srv.close()


if __name__ == "__main__":
    main()
